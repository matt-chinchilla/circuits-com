# circuitcenter.ai — docker-mailserver v15.1.0 configuration
#
# Consumed by docker-compose.mail.yml via `env_file:`. This file is COMMITTED,
# so it contains NO secrets. Every value here is safe to read publicly.
#
# The two real secrets (SES SMTP username + password) are injected by
# docker-compose.mail.yml from /opt/circuits-com/.env on the box, as
# SES_SMTP_USERNAME / SES_SMTP_PASSWORD. They are listed at the bottom of this
# file as commented-out documentation ONLY — do not uncomment them here.
#
# Upstream reference for every variable below:
# https://docker-mailserver.github.io/docker-mailserver/v15.1/config/environment/

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------

# Empty on purpose. The FQDN comes from `hostname:` in docker-compose.mail.yml
# (mail.circuitcenter.ai). Setting OVERRIDE_HOSTNAME as well gives two sources
# of truth for the same thing, and upstream warns it has hard-to-predict side
# effects.
OVERRIDE_HOSTNAME=

# Startup/change-detection verbosity. Raise to `debug` while diagnosing, then
# put it back — `debug` is noisy enough to matter on a 10 GB disk.
LOG_LEVEL=info

# Where DMS's own mail goes: update notices, pflogsumm reports, and the `root:`
# alias. Pointed at the shared role account so operational mail lands in the
# same inbox everyone can see (P4a) instead of a mailbox nobody opens.
POSTMASTER_ADDRESS=no-reply@circuitcenter.ai

# FILE = accounts live in postfix-accounts.cf, managed by the `setup` CLI.
# This is what setup-mailboxes.sh and the P3 push-sync both write to. Empty
# would default to FILE anyway; stated explicitly because `setup email list`
# and Dovecot quota BOTH hard-refuse to run under any other provisioner.
ACCOUNT_PROVISIONER=FILE

# Timezone for logs and Date: headers. Matches the site's EST-based admin dates.
TZ=America/New_York

# Mail from a container IP is treated as authenticated by Postfix's mynetworks.
# `none` forces every sender to authenticate. Anything looser (`network`,
# `connected-networks`) on an internet-exposed box is how you end up an open
# relay. Do not change this.
PERMIT_DOCKER=none

# Check for a new DMS release daily and mail POSTMASTER_ADDRESS when one exists.
# Low volume (only on an actual release) and this box is internet-facing, so
# knowing about security releases is worth the occasional message.
ENABLE_UPDATE_CHECK=1
UPDATE_CHECK_INTERVAL=1d

# The mail box has an IPv4 Elastic IP and no IPv6. Leaving these at `all` makes
# Postfix resolve AAAA records and attempt IPv6 connections that can only fail,
# which shows up as delivery DELAYS (retry timers), not as an obvious error.
POSTFIX_INET_PROTOCOLS=ipv4
DOVECOT_INET_PROTOCOLS=ipv4

# ---------------------------------------------------------------------------
# TLS
# ---------------------------------------------------------------------------

# Reads the certificate from /etc/letsencrypt/live/<hostname>/ — which is the
# host directory bind-mounted read-only in the compose file. The certificate
# MUST already exist before the first `up -d`; DMS falls back to running
# without TLS if it does not, and you will not notice until a client complains.
SSL_TYPE=letsencrypt

# `modern` = TLS 1.2+ with a tight cipher list (DMS default). If a legitimate
# sender ever fails the handshake on port 25, `intermediate` widens the cipher
# list without dropping below TLS 1.2. Change it for a real, observed failure
# in the logs — not preemptively.
TLS_LEVEL=modern

# ---------------------------------------------------------------------------
# Ports / services
# ---------------------------------------------------------------------------

# IMAP on (993 is published). POP3 stays off — nothing here needs it, and every
# enabled daemon is RAM this box does not have.
ENABLE_IMAP=1
ENABLE_POP3=0

# ManageSieve (port 4190) is the protocol for clients to EDIT sieve rules
# remotely. Server-side sieve — including the Junk-folder training that
# RSPAMD_LEARN below relies on — works without it. Off = one less listener.
ENABLE_MANAGESIEVE=

# ---------------------------------------------------------------------------
# Anti-spam / anti-abuse
#
# Deliberate profile for a 1 GB box: rspamd does the filtering, and everything
# rspamd replaces is switched off. Running both stacks would roughly double
# memory for a worse result (double DKIM signatures, conflicting verdicts).
# ---------------------------------------------------------------------------

# ClamAV is OFF because it alone wants ~1 GB of RAM for its signature database
# — more than this entire instance has. This is the single most important line
# in this file for stability. Do not enable it without moving to a larger box.
ENABLE_CLAMAV=0

# Amavis is only the content-filter harness for ClamAV and SpamAssassin. With
# both of those off it is a ~300 MB Perl daemon doing nothing.
ENABLE_AMAVIS=0

# SpamAssassin off — rspamd is the spam filter here. Running both means paying
# twice and reconciling two scores.
ENABLE_SPAMASSASSIN=0
ENABLE_SPAMASSASSIN_KAM=0

# rspamd ON: spam scoring, DKIM signing, DMARC and SPF checks in one daemon.
ENABLE_RSPAMD=1
# rspamd's own bundled Redis, used for the Bayes classifier and greylisting
# state. Persisted via the mail-state volume.
ENABLE_RSPAMD_REDIS=1
# Train the Bayes classifier when a message is dragged into or out of Junk.
# This is the mechanism that makes filtering improve over time instead of
# staying at day-one accuracy forever.
RSPAMD_LEARN=1
# Do NOT re-scan mail from authenticated users. Our own staff sending mail is
# not the threat model, and outbound scanning burns CPU on a 2-vCPU burstable
# instance. DKIM signing of outbound mail still happens regardless.
RSPAMD_CHECK_AUTHENTICATED=0
# Heuristic filters (hostname/HELO sanity checks). Cheap and effective.
RSPAMD_HFILTER=1
RSPAMD_HFILTER_HOSTNAME_UNKNOWN_SCORE=6
# Greylisting OFF. It is genuinely effective, but it delays first-contact mail
# by minutes — and first-contact mail is exactly what this inbox exists for
# (sales and partnership enquiries). Revisit only if spam becomes a problem.
RSPAMD_GREYLISTING=0
# The neural module is upstream-flagged experimental. Not on a production box.
RSPAMD_NEURAL=0

# rspamd owns DKIM/DMARC/SPF, so the standalone daemons are off. Leaving
# ENABLE_OPENDKIM=1 alongside rspamd makes `setup config dkim` manage OpenDKIM
# keys instead of rspamd's, and you end up publishing a key nothing signs with.
ENABLE_OPENDKIM=0
ENABLE_OPENDMARC=0
ENABLE_POLICYD_SPF=0

# Spam is filed into the Junk folder rather than rejected or silently dropped.
# For a business inbox, a false positive that is recoverable from Junk beats a
# false positive that bounced.
MOVE_SPAM_TO_JUNK=1
MARK_SPAM_AS_READ=0

# postscreen: a cheap pre-SMTP gate that rejects zombies/botnets before Postfix
# forks a real smtpd process. `enforce` completes all tests, then rejects with
# 550 and logs the helo/sender/recipient — so a false positive is diagnosable.
# (`drop` gives a 521 and tells you nothing.)
POSTSCREEN_ACTION=enforce

# DNS blocklists inside postscreen. OFF for launch: DNSBL rejects mail outright,
# and a brand-new server with an EIP of unknown history should not be turning
# away enquiries on day one. Turn this to 1 after a week of clean mail logs —
# it is the single biggest load reduction available to this box.
ENABLE_DNSBL=0

# Postgrey is a second greylisting implementation; rspamd already provides one.
ENABLE_POSTGREY=0

# fail2ban bans IPs that brute-force SMTP/IMAP auth. REQUIRES `cap_add:
# NET_ADMIN` in the compose file — without it nftables rules cannot be
# installed and fail2ban logs bans it never actually applies.
ENABLE_FAIL2BAN=1
# `drop` sends no reply at all, so a scanner learns nothing and pays the full
# TCP timeout. `reject` would politely tell them they are blocked.
FAIL2BAN_BLOCKTYPE=drop

# Reject mail from clients whose IP has no resolvable hostname. OFF: this
# rejects a meaningful share of legitimate small-business senders with sloppy
# reverse DNS. rspamd scores the same signal without a hard reject.
POSTFIX_REJECT_UNKNOWN_CLIENT_HOSTNAME=0

# An authenticated user may only send FROM their own address or an alias that
# resolves to them. Without this, any one compromised mailbox password lets an
# attacker send as anyone in the domain — including as the owner.
# Consequence to remember: no-reply@ owns hello@/contact@/info@/sales@/support@
# (see aliases.md), so only no-reply@ can send as those.
SPOOF_PROTECTION=1

# SRS rewrites the envelope sender when FORWARDING to a third-party domain, so
# the forward does not break the original SPF. Every alias here delivers to a
# LOCAL mailbox, so there is nothing to rewrite. If an alias is ever pointed at
# an external address (a personal Gmail, say), set this to 1 at the same time.
ENABLE_SRS=0

# MTA-STS requires publishing and serving a policy over HTTPS. Out of scope
# for P2; revisit alongside the Roundcube web host.
ENABLE_MTA_STS=0

# ---------------------------------------------------------------------------
# Quotas and size limits
# ---------------------------------------------------------------------------

# Dovecot quota enforcement. Also gates the `setup quota set` command that
# setup-mailboxes.sh uses.
ENABLE_QUOTAS=1

# DEFAULT per-mailbox storage cap, in bytes, applied to every account including
# ones created later. 1073741824 = 1 GiB; DMS divides by 1e6 and writes
# `quota_rule = *:storage=1073M`.
#
# setup-mailboxes.sh ALSO sets an explicit 1G per account. The two together are
# belt and braces: this line protects an account somebody provisions by hand
# and forgets to set a quota on. 5 x 1 GiB against a 10 GB disk leaves room for
# the OS, Docker images and logs.
POSTFIX_MAILBOX_SIZE_LIMIT=1073741824

# Maximum accepted message size in bytes. 20971520 = 20 MiB, which is ~28 MB
# once base64-encoded — comfortably under the 40 MB ceiling SES enforces on
# relayed mail. Raising this past ~28 MiB means SES starts rejecting large
# attachments that this server already accepted, which produces bounces rather
# than a clean refusal at submission time.
POSTFIX_MESSAGE_SIZE_LIMIT=20971520

# ---------------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------------

LOGROTATE_INTERVAL=weekly
LOGROTATE_COUNT=4

# ---------------------------------------------------------------------------
# Outbound relay — everything leaves through Amazon SES
#
# Direct delivery from a fresh single IP has poor deliverability, and AWS
# blocks outbound port 25 by default. SES is already verified, DKIM-signing,
# and out of the sandbox (50k/day), so it is the only outbound path.
#
# BOTH variables below are required, and this is the subtle part:
#
#   RELAY_HOST     -> populates sender_dependent_relayhost_maps, which only
#                     covers sender domains DMS manages (circuitcenter.ai).
#   DEFAULT_RELAY_HOST -> sets postfix main.cf:relayhost, the true catch-all.
#                     This is what carries mail whose envelope sender matches
#                     no managed domain — most importantly Postfix's own bounce
#                     and MAILER-DAEMON traffic. Without it those attempt
#                     direct port-25 delivery and silently pile up in the queue.
#
# CRITICAL: DMS writes exactly ONE credential line to /etc/postfix/sasl_passwd,
# keyed on DEFAULT_RELAY_HOST when it is set. Postfix matches that key by exact
# STRING comparison. So DEFAULT_RELAY_HOST must be written as `[RELAY_HOST]:
# RELAY_PORT` character-for-character — brackets included, same port — or the
# sender-dependent path finds no credentials and SES answers 530 Authentication
# required. If you change the region or port, change BOTH lines together.
#
# The brackets suppress an MX lookup on the relay host, which is correct: SES's
# SMTP endpoint is an A record, not an MX.
# ---------------------------------------------------------------------------

RELAY_HOST=email-smtp.us-east-1.amazonaws.com
RELAY_PORT=587
DEFAULT_RELAY_HOST=[email-smtp.us-east-1.amazonaws.com]:587

# ---------------------------------------------------------------------------
# SECRETS — documented here, but NOT set here
#
# These two are the ONLY secrets the mail stack needs. They are supplied by
# docker-compose.mail.yml from /opt/circuits-com/.env on the box:
#
#   RELAY_USER      <- ${SES_SMTP_USERNAME}
#   RELAY_PASSWORD  <- ${SES_SMTP_PASSWORD}
#
# They belong to a dedicated IAM user scoped to ses:SendRawEmail and nothing
# else. The SMTP password is DERIVED from that user's secret access key (see
# README.md) — it is not the secret access key itself.
#
# Deliberately left commented out rather than given a fake value: a placeholder
# that looks like a credential would let the stack start with a broken relay
# and fail at delivery time instead of at boot. The `${VAR:?}` interpolation in
# the compose file makes a missing secret a startup error instead.
#
# RELAY_USER=
# RELAY_PASSWORD=
#
# Rotation: update /opt/circuits-com/.env, then
#   docker compose --env-file /opt/circuits-com/.env -f docker-compose.mail.yml \
#     up -d --force-recreate mailserver
# (`docker compose restart` does NOT re-read the env file.)
# ---------------------------------------------------------------------------
