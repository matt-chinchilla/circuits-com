# Build context exclusions for the API image. Keeps __pycache__ + lint
# caches + test fixtures + the local SQLite test.db out of the image so
# `COPY . .` only ships actual source.

# Python bytecode + per-package metadata
**/__pycache__
*.pyc
*.pyo
*.pyd
*.egg-info
.eggs

# Lint / type-checker / test caches
.pytest_cache
.ruff_cache
.mypy_cache
.pyright
.tox
.coverage
htmlcov

# Local SQLite test database (regenerated per pytest run)
test.db
*.sqlite3

# Virtual envs (uv installs --system in the image)
.venv
venv
env

# Tests + fixtures — image doesn't run pytest. CI/local does.
tests
conftest.py

# Local dev env (never bake creds)
.env
.env.*
!.env.example

# Docs + git noise
*.md
LICENSE*
CHANGELOG*
.git
.gitignore
.gitattributes

# OS noise
.DS_Store
Thumbs.db

# The city-level GeoIP database (~124MB). The IMAGE downloads it in a cached
# build layer straight into app/data/, so shipping the local copy through the
# build context would only overwrite that file with an identical one — at the
# cost of 124MB on every single build. The country-lite file beside it is
# committed and MUST keep shipping: it is the fallback when the city DB is
# absent, and it is what a plain checkout geolocates with.
app/data/dbip-city-lite.mmdb
